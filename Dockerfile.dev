FROM python:3.12-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Copy only the dependency manifest + local packages so Docker layer cache is
# reused when only source code changes (not deps).
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/

# Install dependencies into a container-local virtualenv outside /app, so the
# bind-mounted project directory never uses or hides the host .venv.
# --no-install-project: don't install the top-level package yet (source is
# bind-mounted at runtime).
ENV UV_PROJECT_ENVIRONMENT=/opt/codesandbox/.venv
RUN --network=host uv sync --frozen --no-install-project

ENV PYTHONPATH=/app/src
ENV FLASK_APP=codesandbox.app:app
# FLASK_DEBUG=1 enables the Werkzeug debugger (interactive code execution in browser).
# NEVER set this in production — create a separate Dockerfile.prod without this line.
ENV FLASK_DEBUG=1

EXPOSE 5000

CMD ["uv", "run", "flask", "run", "--host", "0.0.0.0", "--port", "5000", "--debug"]
