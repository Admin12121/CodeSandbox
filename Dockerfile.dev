FROM python:3.12-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Copy the dependency manifest + local packages + src so `uv sync` can fully
# install the project (including editable installs of the two local
# workspace packages) here, with real network access. src/ is ALSO
# bind-mounted at runtime (see `volumes:` in docker-compose.yml) so live
# edits still work with no rebuild — editable installs point at the source
# tree directly and don't need reinstalling when it changes; this COPY only
# exists so the editable install has something to link against during build.
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
COPY src/ ./src/

# Install into a container-local virtualenv outside /app, so the
# bind-mounted project directory never uses or hides the host .venv.
# Full `uv sync` (not --no-install-project): the container's own entrypoint
# used to run `uv run nexorm ...` as its first command in a fresh container,
# which — with only deps pre-installed — triggered an on-the-fly editable
# install of app-router/nexorm requiring their build-system requirements
# (setuptools, wheel) from PyPI. That's fine at build time (--network=host)
# but fails at container runtime, where there's no egress — every full
# container recreation (as opposed to a plain restart) hung/failed here.
ENV UV_PROJECT_ENVIRONMENT=/opt/codesandbox/.venv
RUN --network=host uv sync --frozen

ENV PYTHONPATH=/app/src
ENV FLASK_APP=codesandbox.app:app
# FLASK_DEBUG=1 enables the Werkzeug debugger (interactive code execution in browser).
# NEVER set this in production — create a separate Dockerfile.prod without this line.
ENV FLASK_DEBUG=1

EXPOSE 5000

CMD ["uv", "run", "flask", "run", "--host", "0.0.0.0", "--port", "5000", "--debug"]
