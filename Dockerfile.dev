FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
COPY src/ ./src/

ENV UV_PROJECT_ENVIRONMENT=/opt/codesandbox/.venv
RUN uv sync --frozen

ENV PATH="/opt/codesandbox/.venv/bin:${PATH}"
ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV FLASK_APP=codesandbox.app:app
ENV FLASK_DEBUG=1

EXPOSE 5000

CMD ["/opt/codesandbox/.venv/bin/uvicorn", "codesandbox.asgi:app", "--host", "0.0.0.0", "--port", "5000", "--proxy-headers", "--forwarded-allow-ips=*"]