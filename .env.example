# ── Core ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-32-char-hex-string

APP_URL=http://localhost

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DATABASE_URL=mysql://codesandbox:codesandbox@localhost:3306/codesandbox

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=cs_session
SESSION_TTL_HOURS=24
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# ── Redis (rate limiting + session store) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object storage (MinIO / S3) ───────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=codesandbox
S3_ARTIFACT_BUCKET=codesandbox-artifacts

# ── Worker callbacks ─────────────────────────────────────────────────────────
# Per-job worker callback tokens are signed with SECRET_KEY and expire quickly.
WORKER_CALLBACK_TOKEN_TTL_SECONDS=900
CONTROL_PLANE_INTERNAL_URL=http://app:5000
SANDBOX_JOB_SIGNING_KEY=change-me-generate-an-independent-random-secret
SANDBOX_ALLOWED_IMAGES=docker.io/admin12121/decompile:stable,ubuntu:22.04,busybox:1.36
SANDBOX_REQUIRE_IMAGE_ALLOWLIST=false
SANDBOX_MAX_UPLOAD_BYTES=104857600
SANDBOX_MAX_ARTIFACT_BYTES=524288000
SANDBOX_ARTIFACT_RETENTION_DAYS=30
SANDBOX_PROVISIONING_STALE_SECONDS=300
SANDBOX_HEARTBEAT_STALE_SECONDS=45
SANDBOX_STOPPING_STALE_SECONDS=120
SANDBOX_CLEANUP_STALE_SECONDS=300
SANDBOX_RECONCILE_INTERVAL_SECONDS=30
BILLING_DEV_TOPUP_ENABLED=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Leave blank to use dev mode (verification links printed to console)
RESEND_APIKEY=
FROM_EMAIL=CodeSandbox <noreply@example.com>

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers
# Callback URL: APP_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth — Google ────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: APP_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
