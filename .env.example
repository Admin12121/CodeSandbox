# ── Core ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-32-char-hex-string

APP_URL=http://localhost

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DATABASE_URL=mysql://codesandbox:codesandbox@localhost:3306/codesandbox

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=cs_session
SESSION_TTL_HOURS=24
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# ── Redis (rate limiting + session store) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object storage (MinIO / S3) ───────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=codesandbox

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Leave blank to use dev mode (verification links printed to console)
RESEND_APIKEY=
FROM_EMAIL=CodeSandbox <noreply@example.com>

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers
# Callback URL: APP_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth — Google ────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: APP_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


The vision: each approved organization gets its own dedicated MySQL database (named `codesandbox_org_{slug}`), 
 
